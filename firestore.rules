rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{roomCode} {
      // O código da sala funciona como convite. Apenas clientes autenticados anonimamente
      // conseguem consultar uma sala específica; listagem geral fica bloqueada.
      allow get: if request.auth != null;
      allow list: if false;

      // Criação: o aparelho que cria entra como primeiro participante.
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'code', 'ownerId', 'playerIds', 'currentQuestionId', 'revealed',
          'usedQuestionIds', 'round', 'lastActionMs', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.code == roomCode
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.playerIds.size() == 1
        && request.resource.data.playerIds[0] == request.auth.uid
        && request.resource.data.currentQuestionId == null
        && request.resource.data.revealed == false
        && request.resource.data.usedQuestionIds.size() == 0
        && request.resource.data.round == 0
        && request.resource.data.status == 'waiting';

      allow update: if request.auth != null && (
        // Um aparelho já participante pode atualizar somente o estado da partida.
        (
          resource.data.playerIds.hasAny([request.auth.uid])
          && request.resource.data.playerIds == resource.data.playerIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'currentQuestionId', 'revealed', 'usedQuestionIds', 'round',
            'status', 'lastActionMs', 'updatedAt'
          ])
          && request.resource.data.revealed is bool
          && request.resource.data.usedQuestionIds is list
          && request.resource.data.usedQuestionIds.size() <= 1500
          && request.resource.data.round is int
          && request.resource.data.lastActionMs is int
        )
        ||
        // Entrada do segundo aparelho: só pode acrescentar o próprio UID e a sala aceita 2.
        (
          resource.data.playerIds.size() < 2
          && !resource.data.playerIds.hasAny([request.auth.uid])
          && request.resource.data.playerIds.size() == resource.data.playerIds.size() + 1
          && request.resource.data.playerIds.hasAll(resource.data.playerIds)
          && request.resource.data.playerIds.hasAny([request.auth.uid])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playerIds', 'updatedAt'])
        )
      );

      allow delete: if false;
    }
  }
}
