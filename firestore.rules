rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isPlayer(roomCode) {
      return signedIn()
        && get(/databases/$(database)/documents/rooms/$(roomCode)).data.playerIds.hasAny([request.auth.uid]);
    }

    match /rooms/{roomCode} {
      // A consulta por código é intencional para permitir que o segundo jogador entre.
      // A listagem de todas as salas permanece bloqueada.
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'code', 'ownerId', 'playerIds', 'playerNames', 'mode',
          'currentQuestionId', 'revealed', 'usedQuestionIds', 'round', 'status',
          'turnUid', 'starterUid', 'lastGuess', 'lastGuessByUid', 'challengedByUid',
          'roundLoserUid', 'cardsByPlayer', 'lastActionMs', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.code == roomCode
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.playerIds == [request.auth.uid]
        && request.resource.data.playerNames.keys().hasOnly([request.auth.uid])
        && request.resource.data.cardsByPlayer.keys().hasOnly([request.auth.uid])
        && request.resource.data.playerNames[request.auth.uid] is string
        && request.resource.data.playerNames[request.auth.uid].size() > 0
        && request.resource.data.playerNames[request.auth.uid].size() <= 24
        && request.resource.data.mode == 'chat'
        && request.resource.data.currentQuestionId == null
        && request.resource.data.revealed == false
        && request.resource.data.usedQuestionIds.size() == 0
        && request.resource.data.round == 0
        && request.resource.data.status == 'waiting'
        && request.resource.data.turnUid == request.auth.uid
        && request.resource.data.starterUid == request.auth.uid
        && request.resource.data.lastGuess == null
        && request.resource.data.lastGuessByUid == null
        && request.resource.data.challengedByUid == null
        && request.resource.data.roundLoserUid == null
        && request.resource.data.cardsByPlayer[request.auth.uid] == 0
        && request.resource.data.lastActionMs == 0;

      allow update: if signedIn() && (
        // Participante pode realizar as ações da partida.
        (
          resource.data.playerIds.hasAny([request.auth.uid])
          && request.resource.data.playerIds == resource.data.playerIds
          && request.resource.data.playerNames == resource.data.playerNames
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'currentQuestionId', 'revealed', 'usedQuestionIds', 'round', 'status',
            'turnUid', 'starterUid', 'lastGuess', 'lastGuessByUid', 'challengedByUid',
            'roundLoserUid', 'cardsByPlayer', 'lastActionMs', 'updatedAt'
          ])
          && request.resource.data.revealed is bool
          && request.resource.data.usedQuestionIds is list
          && request.resource.data.usedQuestionIds.size() <= 1500
          && request.resource.data.round is int
          && request.resource.data.status in ['waiting', 'playing', 'resolved']
          && request.resource.data.lastActionMs is int
          && request.resource.data.turnUid in request.resource.data.playerIds
          && request.resource.data.starterUid in request.resource.data.playerIds
          && request.resource.data.cardsByPlayer.keys().hasOnly(request.resource.data.playerIds)
          && (request.resource.data.lastGuess == null || (request.resource.data.lastGuess is int && request.resource.data.lastGuess >= 0))
          && (request.resource.data.lastGuessByUid == null || request.resource.data.lastGuessByUid in request.resource.data.playerIds)
          && (request.resource.data.roundLoserUid == null || request.resource.data.roundLoserUid in request.resource.data.playerIds)
          && (request.resource.data.challengedByUid == null || request.resource.data.challengedByUid in request.resource.data.playerIds)
        )
        ||
        // Entrada do segundo aparelho: acrescenta apenas a própria identidade.
        (
          resource.data.playerIds.size() == 1
          && !resource.data.playerIds.hasAny([request.auth.uid])
          && request.resource.data.playerIds.size() == 2
          && request.resource.data.playerIds.hasAll(resource.data.playerIds)
          && request.resource.data.playerIds.hasAny([request.auth.uid])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'playerIds', 'playerNames', 'cardsByPlayer', 'updatedAt'
          ])
          && request.resource.data.playerNames.diff(resource.data.playerNames).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.cardsByPlayer.diff(resource.data.cardsByPlayer).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.playerNames.keys().hasOnly(request.resource.data.playerIds)
          && request.resource.data.cardsByPlayer.keys().hasOnly(request.resource.data.playerIds)
          && request.resource.data.playerNames[request.auth.uid] is string
          && request.resource.data.playerNames[request.auth.uid].size() > 0
          && request.resource.data.playerNames[request.auth.uid].size() <= 24
          && request.resource.data.cardsByPlayer[request.auth.uid] == 0
        )
      );

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isPlayer(roomCode);
        allow create: if isPlayer(roomCode)
          && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 24
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.createdAt is timestamp;
        allow update, delete: if false;
      }
    }
  }
}
